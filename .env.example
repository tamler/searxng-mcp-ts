# ===========================================
# SearXNG MCP Server Configuration
# ===========================================

# Required: URL of your SearXNG instance
SEARXNG_URL=https://your-searxng-instance.com

# ===========================================
# HTTP Server Configuration
# ===========================================

# Port for HTTP server (default: 3000)
PORT=3000

# Host to bind to (default: 127.0.0.1, use 0.0.0.0 for all interfaces)
HOST=127.0.0.1

# Maximum concurrent sessions (default: 100)
MAX_SESSIONS=100

# ===========================================
# Authentication (Optional)
# ===========================================

# Authorization header (e.g., Bearer token)
# AUTHORIZATION_HEADER=Bearer YOUR_TOKEN_HERE

# ===========================================
# Custom Headers (Optional)
# ===========================================

# Format: X_<NAME>_HEADER=value
# Example: X_API_KEY_HEADER=secret123 becomes X-Api-Key: secret123
# X_API_KEY_HEADER=secret123
# X_CUSTOM_HEADER=CustomValue
