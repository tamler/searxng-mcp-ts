{
  "name": "searxng-mcp-ts-deaquino",
  "version": "0.3.0",
  "description": "MCP for searXNG",
  "license": "MIT",
  "type": "module",
  "bin": {
    "searxng-mcp-ts": "./build/index.js",
    "searxng-mcp-ts-http": "./build/http.js"
  },
  "files": [
    "build"
  ],
  "scripts": {
    "build": "tsc && node -e \"require('fs').chmodSync('build/index.js', '755')\" && node -e \"require('fs').chmodSync('build/http.js', '755')\"",
    "prepare": "npm run build",
    "watch": "tsc --watch",
    "inspector": "npx @modelcontextprotocol/inspector build/index.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/deaquino/searxng-mcp-ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "axios": "^1.13.5",
    "dotenv": "^17.3.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^20.17.32",
    "typescript": "^5.9.3"
  }
}
